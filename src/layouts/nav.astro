---
import "../assets/global.css";
import { Font } from "astro:assets";
import Navaccount from "../components/navaccount.astro";
import Navaccountfallback from "../components/navaccountfallback.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Font cssVariable="--font-material-symbols" preload />
  </head>
  <body>
    <div class="flex flex-col h-screen">
      <nav class="bg-gray-500">
        <div class="flex flex-nowrap justify-between items-center px-2 h-20">
          <a href="/" class="text-3xl font-bold text-white">Flashcards</a>
          <div class="flex flex-nowrap gap-5 items-center">
            <Navaccount server:defer>
              <Navaccountfallback slot="fallback" />
            </Navaccount>
          </div>
        </div>
      </nav>
      <slot />
    </div>
  </body>
</html>
