---
import Navbar from "../layouts/nav.astro";
import { cardClass, cardHTML } from "../assets/createcard";
---

<Navbar>
  <dialog id="importmodal">
    <div class="fixed inset-0 flex justify-center items-center">
      <div
        class="p-2 rounded-lg bg-gray-700 flex flex-col justify-center items-center"
      >
        <h1 class="text-white text-2xl">Import from Quizlet</h1>
        <p class="text-white">
          set "Between term and definition" to "Tab" and "Between rows" to "New
          Line"
        </p>
        <textarea
          id="quizlet-content"
          class="w-200 h-100 rounded-2xl bg-gray-600 resize-none text-white"
          rows="3"></textarea>
        <div class="flex gap-2 mt-2">
          <button
            id="closeImport"
            class="text-white bg-red-500 p-2 rounded-lg cursor-pointer"
            >Close</button
          >
          <button
            id="submitImport"
            class="text-white bg-blue-400 p-2 rounded-lg cursor-pointer"
            >Submit</button
          >
        </div>
      </div>
    </div>
  </dialog>

  <div class="flex flex-col items-center justify-center">
    <h1 class="text-5xl font-bold text-white text-center mt-10">
      Create a New Deck:
    </h1>
    <div class="flex items-center p-3 m-3 w-2/3 bg-gray-400 rounded-2xl">
      <input
        id="deck-title"
        type="text"
        placeholder="Deck Title"
        class="p-3 h-10 w-full rounded-2xl bg-gray-600 text-white text-3xl"
        required
        maxlength="100"
      />
      <button
        id="showImport"
        class="bg-blue-500 m-2 rounded-xl cursor-pointer text-white"
        >Import from Quizlet</button
      >
    </div>

    <div id="card-container" class="flex flex-col w-full h-full items-center">
      <div id="first" class={cardClass} set:html={cardHTML(1)} />
    </div>
    <div class="mb-10">
      <button
        id="new-card"
        type="submit"
        class="bg-white text-black p-3 rounded hover:bg-blue-600 cursor-pointer"
        >New Card
      </button>
      <button
        id="create-deck"
        type="submit"
        class="bg-blue-500 text-white p-3 rounded hover:bg-blue-600 cursor-pointer"
      >
        Create Deck
      </button>
    </div>
  </div>
</Navbar>

<script>
  import { actions } from "astro:actions";
  import { cardClass, cardHTML, parseQuizlet } from "../assets/createcard";
  import { createNotification } from "../assets/createNotification";

  let cardCount = 1;

  const newCardButton = document.getElementById("new-card");
  const cardContainer = document.getElementById("card-container");

  const textareas = document
    .getElementById("first")!
    .querySelectorAll("textarea");
  textareas.forEach((textarea) => {
    textarea.addEventListener("input", () => autoResize(textarea));
  });

  newCardButton?.addEventListener("click", () => {
    cardCount++;
    createCard(cardCount);
  });

  function createCard(num: number, side1: string = "", side2: string = "") {
    const newCard = document.createElement("div");
    newCard.className = cardClass;
    newCard.innerHTML = cardHTML(num);
    const textareas = newCard.querySelectorAll("textarea");
    textareas[0].value = side1;
    textareas[1].value = side2;

    textareas.forEach((textarea) => {
      textarea.addEventListener("input", () => autoResize(textarea));
    });

    cardContainer?.appendChild(newCard);
  }

  function autoResize(textarea: HTMLTextAreaElement) {
    textarea.style.height = "auto";
    textarea.style.height = textarea.scrollHeight + "px";
  }

  const dialog: HTMLDialogElement = document.getElementById(
    "importmodal",
  ) as HTMLDialogElement;

  document.getElementById("showImport")?.addEventListener("click", () => {
    dialog.showModal();
  });

  document.getElementById("closeImport")?.addEventListener("click", () => {
    dialog.close();
  });

  const importTextarea = document.getElementById(
    "quizlet-content",
  ) as HTMLTextAreaElement;

  document.getElementById("submitImport")?.addEventListener("click", () => {
    cardContainer?.replaceChildren();
    cardCount = 0;

    const cards = parseQuizlet(importTextarea.value);
    cards.forEach((card) => {
      cardCount++;
      createCard(cardCount, card.Front, card.Back);
    });

    dialog.close();
  });

  document
    .getElementById("create-deck")
    ?.addEventListener("click", async () => {
      const cards = document.querySelectorAll(".card");
      const deck = Array.from(cards).map((card) => {
        const textareas = card.querySelectorAll("textarea");
        return {
          side1: (textareas[0] as HTMLTextAreaElement).value,
          side2: (textareas[1] as HTMLTextAreaElement).value,
        };
      });
      const deckTitle = (
        document.getElementById("deck-title") as HTMLInputElement
      )?.value;
      const response = await actions.createDeck({
        title: deckTitle,
        deck: deck,
      });
      if (response.data?.status === "success") {
        window.location.href = "/";
      } else {
        createNotification(
          "Error creating deck: " + response.data?.message || "Unknown error",
          3000,
        );
      }
    });
</script>
